{
  "name": "block-platform-desktop",
  "version": "1.0.0",
  "description": "Desktop app for Block Platform",
  "main": "main.js",
  "author": "Block Platform",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blockplatform.desktop",
    "productName": "Block Platform",
    "files": ["main.js"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Block-Platform-Setup-${version}.${ext}"
    }
  }
}
